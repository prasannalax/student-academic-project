# ==========================================
# Student Academic Companion - .gitignore
# ==========================================

# Dependencies
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
server/.env

# Production & Build Artifacts
dist/
build/
client/dist/
client/build/

# Uploaded Files / User-generated Documents (keep directory structure with .gitkeep)
server/uploads/notes/*
!server/uploads/notes/.gitkeep
server/uploads/assignments/*
!server/uploads/assignments/.gitkeep

# Logs and Runtime Data
logs/
*.log

# Editor & IDE Directories
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
